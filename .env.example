# Leave these unset to keep the in-browser demo (localStorage + the small phrasebook).
# Set them to use the API in server/.

VITE_API_BASE_URL=http://localhost:8787/api
# Same value as API_TOKEN in server/.env. This token is visible in the browser;
# it only stops strangers calling your API. The model key stays on the server.
VITE_API_TOKEN=
# Optional. Defaults to VITE_API_BASE_URL.
# VITE_AI_BASE_URL=http://localhost:8787/api

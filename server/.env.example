# Copy to server/.env. The dashboard never reads this file.
# The Anthropic key stays here. Do not put it in .env.local or in the React app.

PORT=8787
# Optional. Set this whenever the API is reachable beyond your own machine.
API_TOKEN=
# Comma-separated browser origins, or * for local development.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
ANTHROPIC_API_KEY=
# A model name, not a secret. This is the current Sonnet id.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Model calls per client per minute. Rule-only reviews do not count.
AI_RATE_LIMIT=30
